//@version=5
indicator("PS60 Desk+", "DESK+", overlay = true, max_lines_count = 300, max_labels_count = 200, max_boxes_count = 10)

// One ATR feeds everything: tank, levels, second entry, probability.
// ATR = prior COMPLETED day, so levels are static all session. Nothing drifts.
// PROB engine: the historical sample is built from a 30-minute data pull, so
// it is NOT capped by the chart's loaded 5-minute bars — trade the 5-minute
// chart and still scan up to the full 300-day sample.
// ATR levels: live color = still reachable, spent color = traveled. Price always shown.
// Tight Box (outlier reject) is OFF by default — turn its MASTER on to replace the
// daily box and drive the second-entry pivot automatically off the box edges.
// Earnings reaction bar + earnings-break stats are OFF by default too.

// ───────── Inputs ─────────
string G1 = "Tank (ATR)"
int    atrLen    = input.int(14, "ATR length (days)", minval = 1, group = G1)
string atrSmooth = input.string("RMA", "Smoothing", options = ["RMA", "EMA", "SMA", "WMA"], group = G1)
bool   showGas   = input.bool(true, "Gas tank readout", group = G1)
bool   showLvls  = input.bool(true, "Remaining-ATR levels (1x 2x 3x)", group = G1)
bool   showHalf  = input.bool(false, "Half-step levels (1.5x 2.5x)", group = G1, tooltip = "Adds 1.5x and 2.5x lines to the ladder, above the high and below the low, with the same live/traveled coloring and price labels. Off by default so nothing changes until you flip it on.")
bool   showOpen  = input.bool(true, "Today's open line", group = G1)
color  cOpenIn   = input.color(color.new(#b2b5be, 0), "Open line color", group = G1)
string tz        = input.string("America/New_York", "Timezone", group = G1)
string lblSzIn   = input.string("tiny", "Label size (all level labels)", options = ["tiny", "small", "normal", "large"], group = G1, tooltip = "Bump to small or normal if the labels are hard to read on the phone.")

string G6 = "ATR level colors + shading"
bool  shadeOn = input.bool(true, "Shade zones between levels", group = G6)
color cLive   = input.color(color.new(#26a69a, 0), "Level line: live", group = G6)
color cSpent  = input.color(color.new(#ef5350, 0), "Level line: traveled", group = G6)
color cZ1     = input.color(color.new(#26a69a, 82), "Zone fill: range → 1x", group = G6)
color cZ2     = input.color(color.new(#ffd500, 82), "Zone fill: 1x → 2x", group = G6)
color cZ3     = input.color(color.new(#8a00ff, 86), "Zone fill: 2x → 3x", group = G6)
color cZSpent = input.color(color.new(#ef5350, 82), "Zone fill when traveled", group = G6)

string GPD = "Prev day levels"
bool  showPDH = input.bool(true, "Prev day high", group = GPD)
bool  showPDL = input.bool(true, "Prev day low", group = GPD)
bool  showPDC = input.bool(true, "Prev day close", group = GPD)
color cPD     = input.color(color.new(#e91e8c, 0), "Color", group = GPD)

string GS = "Premarket / after-hours (locked)"
bool   showPM = input.bool(true, "Premarket high/low", group = GS, tooltip = "Built during the premarket session, then LOCKED at 9:30 and held flat the whole day. No repainting. Intraday charts only. The chart itself must have extended hours turned on or there is no premarket data to read.")
bool   showAH = input.bool(false, "After-hours high/low", group = GS, tooltip = "The last COMPLETED after-hours session, locked and held flat. Intraday charts only. Needs extended hours on the chart.")
string pmSess = input.session("0400-0930", "Premarket session", group = GS)
string ahSess = input.session("1600-2000", "After-hours session", group = GS)
color  cPM    = input.color(color.new(#e91e8c, 0), "Premarket color", group = GS)
color  cAHIn  = input.color(color.new(#ef6c00, 0), "After-hours color", group = GS)

string GM = "Prev month (old supply / demand)"
bool  showSup = input.bool(true, "Old supply (last finished month high)", group = GM)
bool  showDem = input.bool(true, "Old demand (last finished month low)", group = GM)
color cSup    = input.color(color.new(#c62828, 0), "Supply color", group = GM)
color cDem    = input.color(color.new(#2e7d32, 0), "Demand color", group = GM)

string GW = "Whole numbers"
bool   showWhole    = input.bool(true, "Whole-number lines", group = GW)
int    wholeAbove   = input.int(3, "Levels above price", minval = 1, maxval = 15, group = GW)
int    wholeBelow   = input.int(3, "Levels below price", minval = 1, maxval = 15, group = GW)
float  stepIn       = input.float(0.0, "Step (0 = auto: $5 over 200, $1 over 80, else $0.50)", minval = 0.0, step = 0.5, group = GW, tooltip = "Type any increment you want: 1 for every dollar, 5 for fives, 10 for tens. Leave 0 to pick automatically from the stock price.")
color  cWholeIn     = input.color(color.new(#9e9e9e, 55), "Line color", group = GW)
int    wholeW       = input.int(1, "Line width", minval = 1, maxval = 4, group = GW)
string wholeSty     = input.string("solid", "Line style", options = ["solid", "dash", "dot"], group = GW)
string wholeLenMode = input.string("Stub (near price)", "Line length", options = ["Stub (near price)", "Full (across history)"], group = GW)
bool   wholeLblOn   = input.bool(true, "Price labels on the lines", group = GW)
bool   wholeAlertOn = input.bool(false, "Touch alerts (separate from drawing)", group = GW, tooltip = "Arms the 'PS60 whole number touch' alert: it fires when a bar tags any whole-number step, even if the lines themselves are hidden. Set the actual alert from the TradingView alerts panel after turning this on.")

string G3 = "Daily box"
bool  showBox  = input.bool(true, "Show box", group = G3)
int   boxLen   = input.int(10, "Lookback (daily bars)", minval = 5, maxval = 40, group = G3)
bool  boxTight = input.bool(true, "Only draw if tight", group = G3)
float tightX   = input.float(4.0, "Tight = box range ≤ this × ATR", minval = 1.0, step = 0.5, group = G3)
color cBoxIn   = input.color(color.new(#42a5f5, 0), "Box color", group = G3)

string GT = "Tight Box (outlier reject)"
bool  tbOn    = input.bool(false, "MASTER: tight box replaces daily box + drives auto-pivot", group = GT, tooltip = "ON: this box is the box on the chart, and its edges become the second-entry pivots automatically — upper edge = pivot for longs, lower edge = pivot for shorts. Zero manual input, so you can drop the indicator on a whole watchlist and set second-entry alerts everywhere. OFF: everything works exactly like before, manual pivot included. If this AND the daily box are both off, no box draws and no auto-pivot fires.")
int   tbWin   = input.int(10, "Window (completed daily bars)", minval = 5, maxval = 40, group = GT, tooltip = "Uses COMPLETED days only, so the edges stay put all session.")
bool  tbRejOn = input.bool(true, "Outlier rejection", group = GT, tooltip = "Throws out unusually wide days before drawing the box: any day whose high-low range is wider than sensitivity × the window's average range gets excluded. Never rejects below 4 kept days.")
float tbSens  = input.float(1.8, "Sensitivity (lower = stricter)", minval = 1.3, maxval = 2.5, step = 0.1, group = GT)
color cTB     = input.color(color.new(#f5a623, 0), "Tight box color", group = GT)

string G4 = "Second entry"
bool   show2nd    = input.bool(true, "Second-entry helper", group = G4, tooltip = "The first push through the pivot is the 1st wave — buyers or sellers who rush in and immediately take profit. Their profit-taking is the retrace. The second entry is the 2nd cavalry: the real move after the noise. This helper stays quiet through the 1st wave and only arms after the retrace.")
float  pivotIn    = input.float(0.0, "Pivot (0 = off). Type it. Do not guess.", group = G4, tooltip = "Manual pivot. Only used when the Tight Box MASTER is OFF — when it is on, the pivots come from the box edges automatically.")
string sideIn     = input.string("Auto", "Side", options = ["Auto", "Long", "Short"], group = G4)
float  retracePct = input.float(30.0, "Retrace % of first push", minval = 10.0, maxval = 80.0, step = 5.0, group = G4)
float  minRetrX   = input.float(0.3, "AND at least this × ATR", minval = 0.1, step = 0.05, group = G4)
float  nearX      = input.float(0.15, "Alert within this × ATR of second", minval = 0.05, step = 0.05, group = G4)
bool   hourReset  = input.bool(true, "Hourly: miss the 60, need a new second", group = G4)
color  c2ndIn     = input.color(color.new(#6a1b9a, 0), "Second-entry color", group = G4)

string GE = "Earnings reaction bar"
bool   earnOn       = input.bool(false, "Earnings reaction lines + break alerts", group = GE, tooltip = "Finds the earnings release in TradingView's earnings feed, takes the FIRST FULL SESSION AFTER it (weekends and holidays roll to the next trading day), and draws that day's high and low extended forward. A break of either side is the signal for a bigger move — arm the 'PS60 earnings range break UP / DOWN' alerts from the alerts panel.")
string earnDayMode  = input.string("Next session (after-close reports)", "Reaction day", options = ["Next session (after-close reports)", "Same session (pre-market reports)"], group = GE, tooltip = "TradingView's feed marks the report day but does not say whether the company reported before the open or after the close. After the close (the common case, like an Oct 28 report → Oct 29 reaction bar): pick Next session. Before the open: pick Same session.")
bool   earnManualOn = input.bool(false, "Use manual date instead of the automatic feed", group = GE, tooltip = "If the automatic pull is wrong or empty for this symbol, turn this on and set the release date below. The reaction bar is still built with the Reaction day rule above.")
int    earnDateIn   = input.time(timestamp("2025-01-01T00:00:00"), "Manual earnings release date", group = GE)
color  cEarn        = input.color(color.new(#00bcd4, 0), "Line color", group = GE)

string G5 = "Probability (backtest)"
bool  showProb = input.bool(true, "Continuation stats", group = G5, tooltip = "How it works: every past day in loaded history gets its ATR progress (range used ÷ ATR) recorded at twelve 30-minute checkpoints from 10:00 to 15:30, plus where it finished. Live, today's progress at the current checkpoint is matched against those stored days, and the readout tells you how the similar days finished. The sample is built from a 30-minute data pull, so it is NOT capped by the 5-minute chart's loaded history — trade the 5-minute chart and still get up to the full day cap below. It rebuilds every time the script loads and is not saved anywhere. In Bar Replay the pull is cut off at the replay moment, so the sample is exactly what existed then — same construction, no lookahead.")
float tolIn    = input.float(0.15, "Similar day = within this × ATR of today", minval = 0.05, step = 0.05, group = G5, tooltip = "The tolerance band. At the current checkpoint, a past day counts as similar when its ATR progress was within this many ATRs of today's. 0.15 means within 15% of the tank either way. Tighter = fewer but closer matches.")
float tgt1     = input.float(1.0, "Target #1 (× ATR)", minval = 0.5, step = 0.1, group = G5, tooltip = "The readout reports how many similar days finished at or beyond this much total travel. Also used as the run target for the earnings-break stats.")
float tgt2     = input.float(1.5, "Target #2 (× ATR)", minval = 0.5, step = 0.1, group = G5, tooltip = "Second finish line for the odds readout.")
int   maxDays  = input.int(300, "Max days stored", minval = 50, maxval = 500, group = G5, tooltip = "Sample cap — oldest days fall off first. How far back the sample actually reaches depends on how much 30-minute history TradingView serves for the symbol and your plan; the sample-context line in the readout always shows the true span.")
int   minDays  = input.int(20, "Min days before stats print", minval = 5, maxval = 100, group = G5, tooltip = "Below this the sample is too thin to say anything, so the readout stays quiet while it builds.")
bool  probEarnOn = input.bool(false, "Earnings-break stats", group = G5, tooltip = "Needs the earnings reaction bar to have data. Every time price broke the reaction high or low in loaded history, this tracked what happened next: reaching Target #1 × ATR beyond the edge counts as a run; closing back inside the range first counts as a fakeout. The readout line shows how often each happened and the typical run distance.")

// ───────── Fixed colors + small helpers ─────────
color cBoxF = color.new(cBoxIn, 88)
color cGray = color.new(#9e9e9e, 55)

string LSZ = lblSzIn == "small" ? size.small : lblSzIn == "normal" ? size.normal : lblSzIn == "large" ? size.large : size.tiny

bool earnSame = earnDayMode == "Same session (pre-market reports)"

f2(float v) => math.round(v * 100.0) / 100.0

f_fmtKey(int k) =>
    int y = k / 10000
    int m = k / 100 % 100
    int d = k % 100
    string mn = m == 1 ? "Jan" : m == 2 ? "Feb" : m == 3 ? "Mar" : m == 4 ? "Apr" : m == 5 ? "May" : m == 6 ? "Jun" : m == 7 ? "Jul" : m == 8 ? "Aug" : m == 9 ? "Sep" : m == 10 ? "Oct" : m == 11 ? "Nov" : "Dec"
    mn + " " + str.tostring(d) + " '" + str.tostring(y % 100)

// ───────── One ATR to rule them all ─────────
f_atr() =>
    trv = ta.tr(true)
    switch atrSmooth
        "EMA" => ta.ema(trv, atrLen)
        "SMA" => ta.sma(trv, atrLen)
        "WMA" => ta.wma(trv, atrLen)
        => ta.rma(trv, atrLen)

// Tight box over the last tbWin COMPLETED daily bars (offsets 1..tbWin), so the
// edges stay static all session. Outlier reject: drop days wider than
// sensitivity × average range, but never below 4 kept days.
f_tightCalc() =>
    float[] rngs = array.new_float()
    for i = 1 to tbWin
        array.push(rngs, high[i] - low[i])
    float avgR = array.avg(rngs)
    float[] srt = array.copy(rngs)
    array.sort(srt, order.ascending)
    float thr4 = array.get(srt, math.min(3, array.size(srt) - 1))
    float cut = tbRejOn ? math.max(tbSens * avgR, thr4) : 1.0e18
    float hh = na
    float ll = na
    int keptN = 0
    int oldOff = 1
    for i = 1 to tbWin
        if high[i] - low[i] <= cut
            hh := na(hh) ? high[i] : math.max(hh, high[i])
            ll := na(ll) ? low[i] : math.min(ll, low[i])
            keptN += 1
            oldOff := i
    [hh, ll, keptN, time[oldOff]]

f_daily() =>
    float a = f_atr()[1]
    [tbh, tbl, tbk, tbt] = f_tightCalc()
    [a, high, low, open, close[1], time, ta.highest(high, boxLen), ta.lowest(low, boxLen), time[boxLen - 1], tbh, tbl, tbk, tbt]

[yATR, dH, dL, dO, prevC, dT, boxHi, boxLo, boxT0, tbHi, tbLo, tbKept, tbT0] = request.security(syminfo.tickerid, "D", f_daily(), barmerge.gaps_off, barmerge.lookahead_off)

[oldSup, oldDem] = request.security(syminfo.tickerid, "M", [high[1], low[1]], barmerge.gaps_off, barmerge.lookahead_off)

[pdh, pdl, pdc] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], barmerge.gaps_off, barmerge.lookahead_off)

// Premarket/after-hours, LOCKED. Day rollover keys off the calendar date of each
// bar — never ta.change(time("D",...)), which goes na across extended-hours bars
// and silently kills the rollover. Premarket locks at the first RTH bar and holds
// flat all day. After-hours shows the last COMPLETED session, locked flat.
f_sess() =>
    int bk = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
    var int dk = na
    var float pmH_ = na
    var float pmL_ = na
    var float ahH_ = na
    var float ahL_ = na
    var float ahLockH = na
    var float ahLockL = na
    var bool pmLocked = false
    if na(dk) or bk != dk
        if not na(ahH_)
            ahLockH := ahH_
            ahLockL := ahL_
        ahH_ := na
        ahL_ := na
        pmH_ := na
        pmL_ := na
        pmLocked := false
        dk := bk
    bool inPM = not na(time("", pmSess, tz))
    bool inRTH = not na(time("", "0930-1600", tz))
    bool inAH = not na(time("", ahSess, tz))
    if inRTH
        pmLocked := true
    if inPM and not pmLocked
        pmH_ := na(pmH_) ? high : math.max(pmH_, high)
        pmL_ := na(pmL_) ? low : math.min(pmL_, low)
    if inAH
        ahH_ := na(ahH_) ? high : math.max(ahH_, high)
        ahL_ := na(ahL_) ? low : math.min(ahL_, low)
    [pmH_, pmL_, ahLockH, ahLockL]

[pmH, pmL, ahH, ahL] = request.security(syminfo.tickerid, "5", f_sess(), barmerge.gaps_off, barmerge.lookahead_off)

// Earnings reaction bar: the daily bar right after the report prints in the feed
// (or the report day itself for pre-market reports). Manual date fallback uses
// the same reaction-day rule.
f_earn() =>
    float ea = request.earnings(syminfo.tickerid, earnings.actual, barmerge.gaps_on, barmerge.lookahead_off, true)
    bool isE = not na(ea)
    int bk = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
    int mk = year(earnDateIn, tz) * 10000 + month(earnDateIn, tz) * 100 + dayofmonth(earnDateIn, tz)
    bool react = false
    if earnManualOn
        react := earnSame ? bk == mk : bk > mk and bk[1] <= mk
    else
        react := earnSame ? isE : isE[1]
    var float rh = na
    var float rl = na
    var int rt = na
    if react
        rh := high
        rl := low
        rt := time
    [rh, rl, rt]

[erHi, erLo, erT] = request.security(syminfo.tickerid, "D", f_earn(), barmerge.gaps_off, barmerge.lookahead_off)

// ───────── Probability engine: sample + matching in 30-minute data ─────────
// The historical sample AND the matching both run inside this 30-minute
// request.security pull, so a 5-minute chart's ~105-day history limit does not
// cap the sample. Only the finished numbers cross back to the chart — never
// the matrix itself, because TradingView copies a returned collection once per
// chart bar and that blows the memory limit (runtime error RE10139).
// Each historical day's ATR progress is recorded at the twelve 30-minute
// checkpoints (10:00–15:30) plus its finish, keyed off calendar dates, RTH
// bars only, capped at maxDays. Checkpoints store the progress as of the
// checkpoint moment — no lookahead. Each day's ATR and prior close come from
// a nested daily pull using the offset-[1]-plus-lookahead pattern, the
// non-repainting way to read the prior COMPLETED day.
f_prob30() =>
    [dAtr, dPrevC] = request.security(syminfo.tickerid, "D", [f_atr()[1], close[1]], barmerge.gaps_off, barmerge.lookahead_on)
    var matrix<float> m = matrix.new<float>(0, 12)
    var float[] fin = array.new_float()
    var int[] keys = array.new_int()
    var float[] cp12 = array.new_float(12, na)
    var float hh = na
    var float ll = na
    var float lp = na
    var int dk = na
    int bk = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
    if na(dk) or bk != dk
        if not na(lp)
            matrix.add_row(m, matrix.rows(m), array.copy(cp12))
            array.push(fin, lp)
            array.push(keys, dk)
            if array.size(fin) > maxDays
                matrix.remove_row(m, 0)
                array.shift(fin)
                array.shift(keys)
        for i = 0 to 11
            array.set(cp12, i, na)
        hh := na
        ll := na
        lp := na
        dk := bk
    float mins = (time - timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), 9, 30)) / 60000.0
    bool rth = not na(time("", "0930-1600", tz))
    if rth and not na(dAtr) and dAtr > 0
        float uPre = not na(hh) ? (not na(dPrevC) ? math.max(hh - ll, math.abs(hh - dPrevC), math.abs(ll - dPrevC)) : hh - ll) : na
        float progPre = not na(uPre) ? uPre / dAtr : na
        if not na(progPre)
            for k = 0 to 11
                if mins >= 30.0 * (k + 1) and na(array.get(cp12, k))
                    array.set(cp12, k, progPre)
        hh := na(hh) ? high : math.max(hh, high)
        ll := na(ll) ? low : math.min(ll, low)
        float uNow = not na(dPrevC) ? math.max(hh - ll, math.abs(hh - dPrevC), math.abs(ll - dPrevC)) : hh - ll
        lp := uNow / dAtr
    int kNow30 = -1
    if rth
        for k = 0 to 11
            if mins >= 30.0 * (k + 1)
                kNow30 := k
    int nM = 0
    int hA = 0
    int hB = 0
    float sumF = 0.0
    if kNow30 >= 0 and not na(lp) and array.size(fin) > 0
        for i = 0 to array.size(fin) - 1
            float cp = matrix.get(m, i, kNow30)
            if not na(cp) and math.abs(cp - lp) <= tolIn
                nM += 1
                float fv = array.get(fin, i)
                sumF += fv
                if fv >= tgt1
                    hA += 1
                if fv >= tgt2
                    hB += 1
    [nM, hA, hB, sumF, array.size(fin), array.size(keys) > 0 ? array.get(keys, 0) : int(na), lp]

[pN, pH1, pH2, pSum, pTot, pFirst, pProg] = request.security(syminfo.tickerid, "30", f_prob30(), barmerge.gaps_off, barmerge.lookahead_off)

// ───────── Tank math ─────────
bool isToday = not na(dT) and year(dT, tz) == year(timenow, tz) and month(dT, tz) == month(timenow, tz) and dayofmonth(dT, tz) == dayofmonth(timenow, tz)

float used = isToday and not na(dH) and not na(dL) and not na(prevC) ? math.max(dH - dL, math.abs(dH - prevC), math.abs(dL - prevC)) : 0.0
float leftT = na(yATR) ? na : math.max(0.0, yATR - used)
float pctLeft = not na(yATR) and yATR > 0 ? math.max(0.0, 100.0 - used / yATR * 100.0) : na
float xATR = not na(yATR) and yATR > 0 ? used / yATR : na

// ───────── Probability engine: TODAY's live progress ─────────
// Only today's live tracking runs on the chart's bars — the historical sample
// comes from the 30-minute pull above. Day rollover keys off the calendar date
// of each bar (works with or without extended hours). Range tracker seeds ONLY
// from RTH bars.
var float rHi           = na
var float rLo           = na
var float lastProg      = na
var int   dayKey        = na
var int   sessCount     = 0

int sessStart   = timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), 9, 30)
float minsSince = (time - sessStart) / 60000.0

bool rthBar = not na(time(timeframe.period, "0930-1600", tz))

int barKey = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
bool newSess = na(dayKey) or barKey != dayKey

if timeframe.isintraday
    if newSess
        sessCount += 1
        rHi := na
        rLo := na
        lastProg := na
        dayKey := barKey
    if rthBar
        rHi := na(rHi) ? high : math.max(rHi, high)
        rLo := na(rLo) ? low : math.min(rLo, low)
        float uNow = not na(prevC) ? math.max(rHi - rLo, math.abs(rHi - prevC), math.abs(rLo - prevC)) : rHi - rLo
        float prog = not na(yATR) and yATR > 0 ? uNow / yATR : na
        if not na(prog)
            lastProg := prog

// ───────── Earnings-break stats ─────────
// For every earnings reaction range in loaded history: a break of the high or
// low either RUNS (reaches tgt1 × ATR beyond the edge) or FAKES OUT (closes
// back inside the range first). Each side of each event is scored once.
int erKeyDate = not na(erT) ? year(erT, tz) * 10000 + month(erT, tz) * 100 + dayofmonth(erT, tz) : int(na)
bool earnAfter = not na(erKeyDate) and barKey > erKeyDate

var int   ebKey    = na
var bool  ebUpB    = false
var bool  ebUpR    = false
var float ebUpMax  = na
var int   ebUpSess = na
var bool  ebDnB    = false
var bool  ebDnR    = false
var float ebDnMax  = na
var int   ebDnSess = na
var int   ebEvents = 0
var int   ebFirstKey = na
var int   ebN      = 0
var int   ebHit    = 0
var int   ebFake   = 0
var int   ebRes    = 0
var float ebRunSum = 0.0
var float ebSessSum = 0.0

if probEarnOn and timeframe.isintraday and not na(erHi) and not na(erLo) and not na(erT)
    if na(ebKey) or erT != ebKey
        ebKey    := erT
        ebEvents += 1
        ebUpB    := false
        ebUpR    := false
        ebUpMax  := na
        ebUpSess := na
        ebDnB    := false
        ebDnR    := false
        ebDnMax  := na
        ebDnSess := na
    if earnAfter and not na(yATR) and yATR > 0
        if not ebUpB and high > erHi
            ebUpB    := true
            ebUpMax  := high - erHi
            ebUpSess := sessCount
            ebN      += 1
            if na(ebFirstKey)
                ebFirstKey := barKey
        if ebUpB and not ebUpR
            ebUpMax := math.max(ebUpMax, high - erHi)
            if ebUpMax >= tgt1 * yATR
                ebUpR    := true
                ebHit    += 1
                ebRes    += 1
                ebRunSum += ebUpMax / yATR
                ebSessSum += sessCount - ebUpSess
            else if close < erHi
                ebUpR    := true
                ebFake   += 1
                ebRes    += 1
                ebRunSum += ebUpMax / yATR
                ebSessSum += sessCount - ebUpSess
        if not ebDnB and low < erLo
            ebDnB    := true
            ebDnMax  := erLo - low
            ebDnSess := sessCount
            ebN      += 1
            if na(ebFirstKey)
                ebFirstKey := barKey
        if ebDnB and not ebDnR
            ebDnMax := math.max(ebDnMax, erLo - low)
            if ebDnMax >= tgt1 * yATR
                ebDnR    := true
                ebHit    += 1
                ebRes    += 1
                ebRunSum += ebDnMax / yATR
                ebSessSum += sessCount - ebDnSess
            else if close > erLo
                ebDnR    := true
                ebFake   += 1
                ebRes    += 1
                ebRunSum += ebDnMax / yATR
                ebSessSum += sessCount - ebDnSess

// ───────── Draw helpers ─────────
var line[]     L  = array.new_line()
var label[]    B  = array.new_label()
var linefill[] LF = array.new_linefill()

f_wipe() =>
    if array.size(L) > 0
        for i = 0 to array.size(L) - 1
            line.delete(array.get(L, i))
        array.clear(L)
    if array.size(B) > 0
        for i = 0 to array.size(B) - 1
            label.delete(array.get(B, i))
        array.clear(B)
    if array.size(LF) > 0
        for i = 0 to array.size(LF) - 1
            linefill.delete(array.get(LF, i))
        array.clear(LF)

f_lvl(bool on, float y, color c, string sty, int w, string name) =>
    if on and not na(y)
        string st = sty == "dash" ? line.style_dashed : sty == "dot" ? line.style_dotted : line.style_solid
        array.push(L, line.new(bar_index - 8, y, bar_index + 2, y, extend = extend.right, color = c, width = w, style = st))
        if name != ""
            array.push(B, label.new(bar_index + 3, y, name, style = label.style_label_left, color = color.new(c, 30), textcolor = color.white, size = LSZ))

f_atrLine(float y, color c, int w, string name) =>
    line ln = line.new(bar_index - 8, y, bar_index + 2, y, extend = extend.right, color = c, width = w, style = line.style_solid)
    array.push(L, ln)
    if name != ""
        array.push(B, label.new(bar_index + 3, y, name, style = label.style_label_left, color = color.new(c, 30), textcolor = color.white, size = LSZ))
    ln

f_atrTag(string ms, float px, bool sp) =>
    sp ? ms + " ATR Traveled " + str.tostring(f2(px)) : ms + " " + str.tostring(f2(px))

f_step(float p) =>
    stepIn > 0 ? stepIn : p >= 200 ? 5.0 : p >= 80 ? 1.0 : 0.5

f_whole(float y) =>
    string st = wholeSty == "dash" ? line.style_dashed : wholeSty == "dot" ? line.style_dotted : line.style_solid
    bool fullLen = wholeLenMode == "Full (across history)"
    array.push(L, line.new(bar_index - 8, y, bar_index + 2, y, extend = fullLen ? extend.both : extend.right, color = cWholeIn, width = wholeW, style = st))
    if wholeLblOn
        array.push(B, label.new(bar_index + 3, y, str.tostring(y, format.mintick), style = label.style_label_left, color = color.new(cWholeIn, 30), textcolor = color.white, size = LSZ))

// ───────── Second entry ─────────
// Tight box MASTER on → pivots come from the box edges automatically:
// upper edge = pivot for longs, lower edge = pivot for shorts, fresh each day.
// Master off → the manual pivot input works exactly like before.
var bool   seThru     = false
var float  seExt      = na
var bool   sePulled   = false
var string seSide     = "Long"
var float  sePivot    = na
var float  manualPrev = 0.0
var int    seDayKey   = na

bool autoPiv = tbOn and not na(tbHi) and not na(tbLo)

if not autoPiv and pivotIn != manualPrev
    seThru     := false
    seExt      := na
    sePulled   := false
    sePivot    := pivotIn
    manualPrev := pivotIn
    seSide     := sideIn == "Short" ? "Short" : "Long"

if autoPiv and (na(seDayKey) or barKey != seDayKey)
    seThru   := false
    seExt    := na
    sePulled := false
    sePivot  := na
    seDayKey := barKey

bool seOn = show2nd and (autoPiv or pivotIn > 0)

int  hourT = request.security(syminfo.tickerid, "60", time, barmerge.gaps_off, barmerge.lookahead_off)
bool newHour = not na(hourT) and ta.change(hourT) != 0
bool useHour = hourReset and timeframe.isintraday
if seOn and useHour and newHour
    seExt    := na
    sePulled := false

if seOn
    if not seThru
        if autoPiv
            if high > tbHi
                seThru  := true
                seSide  := "Long"
                sePivot := tbHi
                seExt   := high
            else if low < tbLo
                seThru  := true
                seSide  := "Short"
                sePivot := tbLo
                seExt   := low
        else
            if sideIn == "Short" or (sideIn == "Auto" and low < pivotIn and high <= pivotIn)
                if low < pivotIn
                    seThru  := true
                    seSide  := "Short"
                    sePivot := pivotIn
                    seExt   := low
            if sideIn == "Long" or (sideIn == "Auto" and high > pivotIn)
                if high > pivotIn
                    seThru  := true
                    seSide  := "Long"
                    sePivot := pivotIn
                    seExt   := high
    else
        float floorR = not na(yATR) and yATR > 0 ? minRetrX * yATR : 0.0
        if seSide == "Long"
            seExt := na(seExt) ? high : math.max(seExt, high)
            float push = seExt - sePivot
            float need = math.max(push * retracePct / 100.0, floorR)
            if not sePulled and push > 0 and need > 0 and low <= seExt - need
                sePulled := true
        else
            seExt := na(seExt) ? low : math.min(seExt, low)
            float push = sePivot - seExt
            float need = math.max(push * retracePct / 100.0, floorR)
            if not sePulled and push > 0 and need > 0 and high >= seExt + need
                sePulled := true

bool seNear = seOn and sePulled and not na(seExt) and not na(yATR) and yATR > 0 and math.abs(close - seExt) <= nearX * yATR

alertcondition(seNear, title = "PS60 second entry approaching", message = "Approaching second entry. Retrace happened. Not the first push.")

// ───────── Whole-number + earnings alerts ─────────
float wStepG = f_step(close)
bool wholeTag = wholeAlertOn and math.floor(high / wStepG) >= math.ceil(low / wStepG)
alertcondition(wholeTag, title = "PS60 whole number touch", message = "Price tagged a whole-number level.")

bool earnUpX = earnOn and earnAfter and ta.crossover(high, erHi)
bool earnDnX = earnOn and earnAfter and ta.crossunder(low, erLo)
alertcondition(earnUpX, title = "PS60 earnings range break UP", message = "Price broke above the earnings reaction high.")
alertcondition(earnDnX, title = "PS60 earnings range break DOWN", message = "Price broke below the earnings reaction low.")

// ───────── Box ─────────
bool tightOK = not boxTight or (not na(boxHi) and not na(boxLo) and not na(yATR) and yATR > 0 and (boxHi - boxLo) <= tightX * yATR)
bool drawBox = showBox and not tbOn and tightOK and not na(boxHi) and not na(boxLo)
bool drawTB  = tbOn and not na(tbHi) and not na(tbLo)

var box theBox = na

// ───────── Today's 9:30 anchor for the open line ─────────
var int   opT   = na
var float opP   = na
var int   opKey = na
if timeframe.isintraday and rthBar and (na(opKey) or barKey != opKey)
    opT   := time
    opP   := open
    opKey := barKey

// ───────── Price-scale registration ─────────
// Invisible plots: no lines on the pane, just the value tags in the right-hand
// price scale (turn on "Indicator name/value labels" in chart settings if hidden).
plot(showPDH ? pdh : na, "Prev day high", color.new(cPD, 0), 1, display = display.price_scale)
plot(showPDL ? pdl : na, "Prev day low", color.new(cPD, 0), 1, display = display.price_scale)
plot(showPDC ? pdc : na, "Prev day close", color.new(cPD, 0), 1, display = display.price_scale)
plot(showSup ? oldSup : na, "Old supply (prev month high)", color.new(cSup, 0), 1, display = display.price_scale)
plot(showDem ? oldDem : na, "Old demand (prev month low)", color.new(cDem, 0), 1, display = display.price_scale)
plot(showPM and timeframe.isintraday ? pmH : na, "Premarket high", color.new(cPM, 0), 1, display = display.price_scale)
plot(showPM and timeframe.isintraday ? pmL : na, "Premarket low", color.new(cPM, 0), 1, display = display.price_scale)
plot(showAH and timeframe.isintraday ? ahH : na, "After-hours high", color.new(cAHIn, 0), 1, display = display.price_scale)
plot(showAH and timeframe.isintraday ? ahL : na, "After-hours low", color.new(cAHIn, 0), 1, display = display.price_scale)
plot(showOpen ? dO : na, "Today's open", color.new(cOpenIn, 0), 1, display = display.price_scale)
plot(earnOn ? erHi : na, "Earnings reaction high", color.new(cEarn, 0), 1, display = display.price_scale)
plot(earnOn ? erLo : na, "Earnings reaction low", color.new(cEarn, 0), 1, display = display.price_scale)
plot(tbOn ? tbHi : na, "Tight box top", color.new(cTB, 0), 1, display = display.price_scale)
plot(tbOn ? tbLo : na, "Tight box bottom", color.new(cTB, 0), 1, display = display.price_scale)
plot(showWhole ? math.round(close / wStepG) * wStepG : na, "Whole number (nearest)", color.new(cWholeIn, 0), 1, display = display.price_scale)

// ───────── Redraw everything on the last bar ─────────
if barstate.islast
    f_wipe()
    bool intra = timeframe.isintraday
    if not na(theBox)
        box.delete(theBox)
        theBox := na
    if drawTB
        theBox := box.new(tbT0, tbHi, timenow + 3 * 24 * 60 * 60 * 1000, tbLo, xloc = xloc.bar_time, border_color = cTB, border_width = 2, bgcolor = color.new(cTB, 88), extend = extend.right)
        f_lvl(true, tbHi, cTB, "solid", 1, "TIGHT EDGE " + str.tostring(f2(tbHi)) + " · kept " + str.tostring(math.round(tbKept)) + "/" + str.tostring(tbWin))
        f_lvl(true, tbLo, cTB, "solid", 1, "TIGHT EDGE " + str.tostring(f2(tbLo)))
    else if drawBox
        theBox := box.new(boxT0, boxHi, timenow + 3 * 24 * 60 * 60 * 1000, boxLo, xloc = xloc.bar_time, border_color = cBoxIn, border_width = 2, bgcolor = cBoxF, extend = extend.right)
        f_lvl(true, boxHi, cBoxIn, "solid", 1, "EDGE " + str.tostring(f2(boxHi)))
        f_lvl(true, boxLo, cBoxIn, "solid", 1, "EDGE " + str.tostring(f2(boxLo)))

    f_lvl(showSup, oldSup, cSup, "solid", 2, "old supply " + str.tostring(f2(oldSup)))
    f_lvl(showDem, oldDem, cDem, "solid", 2, "old demand " + str.tostring(f2(oldDem)))
    f_lvl(showPDH, pdh, cPD, "solid", 2, "PDH " + str.tostring(f2(pdh)))
    f_lvl(showPDL, pdl, cPD, "solid", 2, "PDL " + str.tostring(f2(pdl)))
    f_lvl(showPDC, pdc, cPD, "dot", 1, "PDC " + str.tostring(f2(pdc)))
    f_lvl(showPM and intra, pmH, cPM, "dash", 1, "PMH " + str.tostring(f2(pmH)))
    f_lvl(showPM and intra, pmL, cPM, "dash", 1, "PML " + str.tostring(f2(pmL)))
    f_lvl(showAH and intra, ahH, cAHIn, "dash", 1, "AHH " + str.tostring(f2(ahH)))
    f_lvl(showAH and intra, ahL, cAHIn, "dash", 1, "AHL " + str.tostring(f2(ahL)))

    if earnOn
        f_lvl(true, erHi, cEarn, "solid", 2, "EARN H " + str.tostring(f2(erHi)))
        f_lvl(true, erLo, cEarn, "solid", 2, "EARN L " + str.tostring(f2(erLo)))

    if showOpen
        if intra and not na(opT) and not na(opP) and opKey == barKey
            array.push(L, line.new(opT, opP, time, opP, xloc = xloc.bar_time, color = cOpenIn, width = 1))
            array.push(B, label.new(bar_index + 3, opP, "Open " + str.tostring(f2(opP)), style = label.style_label_left, color = color.new(cOpenIn, 30), textcolor = color.white, size = LSZ))
        else if not intra and isToday and not na(dO)
            f_lvl(true, dO, cOpenIn, "solid", 1, "Open " + str.tostring(f2(dO)))

    if showLvls and isToday and not na(yATR) and yATR > 0
        float r1  = 1.0 * yATR - used
        float r15 = 1.5 * yATR - used
        float r2  = 2.0 * yATR - used
        float r25 = 2.5 * yATR - used
        float r3  = 3.0 * yATR - used

        line hiLn = f_atrLine(dH, color.new(cGray, 40), 1, "High " + str.tostring(f2(dH)))
        line loLn = f_atrLine(dL, color.new(cGray, 40), 1, "Low " + str.tostring(f2(dL)))

        line u1 = f_atrLine(dH + r1, r1 <= 0 ? cSpent : cLive, 2, f_atrTag("1x", dH + r1, r1 <= 0))
        line d1 = f_atrLine(dL - r1, r1 <= 0 ? cSpent : cLive, 2, f_atrTag("1x", dL - r1, r1 <= 0))
        line u2 = f_atrLine(dH + r2, r2 <= 0 ? cSpent : cLive, 1, f_atrTag("2x", dH + r2, r2 <= 0))
        line d2 = f_atrLine(dL - r2, r2 <= 0 ? cSpent : cLive, 1, f_atrTag("2x", dL - r2, r2 <= 0))
        line u3 = f_atrLine(dH + r3, r3 <= 0 ? cSpent : cLive, 1, f_atrTag("3x", dH + r3, r3 <= 0))
        line d3 = f_atrLine(dL - r3, r3 <= 0 ? cSpent : cLive, 1, f_atrTag("3x", dL - r3, r3 <= 0))

        if showHalf
            f_atrLine(dH + r15, r15 <= 0 ? cSpent : cLive, 1, f_atrTag("1.5x", dH + r15, r15 <= 0))
            f_atrLine(dL - r15, r15 <= 0 ? cSpent : cLive, 1, f_atrTag("1.5x", dL - r15, r15 <= 0))
            f_atrLine(dH + r25, r25 <= 0 ? cSpent : cLive, 1, f_atrTag("2.5x", dH + r25, r25 <= 0))
            f_atrLine(dL - r25, r25 <= 0 ? cSpent : cLive, 1, f_atrTag("2.5x", dL - r25, r25 <= 0))

        if shadeOn
            array.push(LF, linefill.new(hiLn, u1, r1 <= 0 ? cZSpent : cZ1))
            array.push(LF, linefill.new(loLn, d1, r1 <= 0 ? cZSpent : cZ1))
            array.push(LF, linefill.new(u1, u2, r2 <= 0 ? cZSpent : cZ2))
            array.push(LF, linefill.new(d1, d2, r2 <= 0 ? cZSpent : cZ2))
            array.push(LF, linefill.new(u2, u3, r3 <= 0 ? cZSpent : cZ3))
            array.push(LF, linefill.new(d2, d3, r3 <= 0 ? cZSpent : cZ3))

    if showWhole
        float base = math.round(close / wStepG) * wStepG
        for i = 1 to wholeAbove
            f_whole(base + wStepG * i)
        for i = 1 to wholeBelow
            f_whole(base - wStepG * i)

    if seOn and not na(seExt)
        f_lvl(true, seExt, c2ndIn, "solid", 2, sePulled ? "2ND" : "1st push")
        f_lvl(true, sePivot, c2ndIn, "dot", 1, "pivot " + str.tostring(f2(sePivot)))

// ───────── Probability readout ─────────
string probLine    = ""
string probVerdict = ""
string probCounts  = ""
string probSample  = ""
color  vCol  = color.new(color.gray, 0)
color  vTxtC = color.white
if showProb
    if not timeframe.isintraday
        probLine := "TODAY · needs an intraday chart"
    else
        int kNow = -1
        for k = 0 to 11
            if minsSince >= 30.0 * (k + 1)
                kNow := k
        if kNow < 0
            probLine := "TODAY · odds start at 10:00"
        else if pTot < minDays
            probLine := "TODAY · building sample (" + str.tostring(math.round(pTot)) + " days stored)"
        else if na(pProg)
            probLine := "TODAY · no data yet"
        else if pN == 0
            probLine := "TODAY · no similar days in sample"
        else
            float pct1 = 100.0 * pH1 / pN
            probLine := "TODAY · " + str.tostring(math.round(pN)) + " similar days  " + str.tostring(math.round(pct1)) + "% ≥" + str.tostring(tgt1) + "x  " + str.tostring(math.round(100.0 * pH2 / pN)) + "% ≥" + str.tostring(tgt2) + "x  avg " + str.tostring(f2(pSum / pN)) + "x"
            string thin = pN < 10 ? " (thin sample, trust it less)" : ""
            probVerdict := (pct1 >= 70 ? "STRONG GO" : pct1 >= 55 ? "LEANS GO" : pct1 >= 45 ? "COIN FLIP" : "USUALLY STALLS") + " — " + str.tostring(math.round(pct1)) + "% continued" + thin
            vCol  := pct1 >= 55 ? color.new(#26a69a, 0) : pct1 >= 45 ? color.new(#ffd500, 0) : color.new(#ef5350, 0)
            vTxtC := pct1 >= 45 ? color.black : color.white
            probCounts := "TODAY · " + str.tostring(math.round(pN)) + " days looked like today. " + str.tostring(math.round(pH1)) + " reached " + str.tostring(tgt1) + "x, " + str.tostring(math.round(pH2)) + " reached " + str.tostring(tgt2) + "x. Typical finish " + str.tostring(f2(pSum / pN)) + "x."
            string firstD = not na(pFirst) ? f_fmtKey(math.round(pFirst)) : "?"
            probSample := "TODAY · " + str.tostring(math.round(pN)) + " of " + str.tostring(math.round(pTot)) + " days scanned, " + firstD + " – today (" + str.tostring(math.round(100.0 * pN / pTot)) + "% match)"

string earnLine  = ""
string earnLine2 = ""
if probEarnOn and timeframe.isintraday
    if na(erHi)
        earnLine := "EARN · waiting for earnings data (or set the manual date)"
    else if ebRes == 0
        earnLine := "EARN · no resolved breaks in loaded history yet"
    else
        string liveTag = ebUpB and not ebUpR ? "BREAK UP LIVE · " : ebDnB and not ebDnR ? "BREAK DOWN LIVE · " : ""
        string sinceTxt = not na(ebFirstKey) ? " since " + f_fmtKey(ebFirstKey) : ""
        earnLine := "EARN · " + liveTag + str.tostring(ebRes) + " breaks across " + str.tostring(ebEvents) + " earnings" + sinceTxt + ": " + str.tostring(math.round(100.0 * ebHit / ebRes)) + "% ran +" + str.tostring(tgt1) + "x, " + str.tostring(math.round(100.0 * ebFake / ebRes)) + "% faked out"
        float runX = ebRunSum / ebRes
        float runDollars = not na(yATR) ? runX * yATR : na
        float runPct = not na(runDollars) and close > 0 ? runDollars / close * 100.0 : na
        float sessAvg = ebSessSum / ebRes
        string resolveTxt = sessAvg < 0.5 ? "same session" : "~" + str.tostring(math.round(sessAvg)) + " session" + (math.round(sessAvg) > 1 ? "s" : "")
        earnLine2 := "EARN · typical run +" + str.tostring(f2(runX)) + "x ATR ≈ $" + str.tostring(f2(runDollars)) + " (" + str.tostring(f2(runPct)) + "% move) · resolves in " + resolveTxt

// ───────── Gas tank readout ─────────
// Rows are packed top-down and the table is cleared first, so switched-off
// lines leave no empty ghost boxes behind.
var table g = table.new(position.top_center, 1, 8, border_width = 1, border_color = color.new(color.white, 50))

if barstate.islast
    table.clear(g, 0, 0, 0, 7)
    if showGas
        string t1 = not isToday ? "GAS waiting 9:30   tank " + str.tostring(f2(yATR)) : "GAS " + str.tostring(math.round(pctLeft)) + "% left   " + str.tostring(f2(xATR)) + "x ATR traveled"
        string t2 = "used " + str.tostring(f2(used)) + " / tank " + str.tostring(f2(yATR)) + "   left " + str.tostring(f2(leftT))
        color bg = not isToday ? color.new(color.gray, 0) : pctLeft >= 40 ? color.new(color.green, 0) : pctLeft >= 15 ? color.new(#ffd500, 5) : color.rgb(215, 133, 133)
        table.cell(g, 0, 0, t1, bgcolor = bg, text_color = color.black, text_size = size.small)
        table.cell(g, 0, 1, t2, bgcolor = color.new(color.black, 20), text_color = color.white, text_size = size.tiny)
        int rIdx = 2
        if showProb and probLine != ""
            table.cell(g, 0, rIdx, probLine, bgcolor = color.new(#1a1a2e, 10), text_color = color.new(#4deeea, 0), text_size = size.tiny)
            rIdx += 1
        if showProb and probVerdict != ""
            table.cell(g, 0, rIdx, probVerdict, bgcolor = vCol, text_color = vTxtC, text_size = size.small)
            rIdx += 1
        if showProb and probCounts != ""
            table.cell(g, 0, rIdx, probCounts, bgcolor = color.new(#1a1a2e, 10), text_color = color.new(#4deeea, 0), text_size = size.tiny)
            rIdx += 1
        if showProb and probSample != ""
            table.cell(g, 0, rIdx, probSample, bgcolor = color.new(#1a1a2e, 10), text_color = color.new(#4deeea, 30), text_size = size.tiny)
            rIdx += 1
        if probEarnOn and earnLine != ""
            table.cell(g, 0, rIdx, earnLine, bgcolor = color.new(#2e1e00, 5), text_color = color.new(#ffd54f, 0), text_size = size.tiny)
            rIdx += 1
        if probEarnOn and earnLine2 != ""
            table.cell(g, 0, rIdx, earnLine2, bgcolor = color.new(#2e1e00, 5), text_color = color.new(#ffd54f, 0), text_size = size.tiny)
            rIdx += 1

var table seT = table.new(position.bottom_right, 1, 1, border_width = 1)
if barstate.islast
    if seOn
        string pivTxt = autoPiv and not seThru ? str.tostring(f2(tbHi)) + " / " + str.tostring(f2(tbLo)) : str.tostring(f2(sePivot))
        string st = not seThru ? "WAIT through " + pivTxt : not sePulled ? "THROUGH  push " + str.tostring(f2(seExt)) + "  wait retrace" : seNear ? "2ND NEAR  " + str.tostring(f2(seExt)) : "2ND ARMED  " + str.tostring(f2(seExt))
        table.cell(seT, 0, 0, st, bgcolor = seNear ? c2ndIn : color.new(color.black, 20), text_color = color.white, text_size = size.small)
    else
        table.clear(seT, 0, 0, 0, 0)
