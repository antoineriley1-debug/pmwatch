//@version=5
indicator("PS60 Scanner", "PS60-SCAN", overlay = true)

// Watchlist scanner for the PS60 second entry. Put this on ANY chart, type your
// tickers into the settings once, and create ONE alert with the condition
// "Any alert() function call" — the alert message names which ticker armed and
// which side. Up to 15 tickers per copy (Pine's data-pull budget); run a second
// copy of the scanner for the next 15.
//
// Engine per ticker = the desk's auto-pivot rules: tight box from completed
// daily bars (outlier reject), upper edge = long pivot, lower edge = short
// pivot, break -> retrace -> second entry, evaluated on that ticker's own
// 5-minute data regardless of what chart this sits on.

// ───────── Inputs ─────────
string G1 = "ATR (matches the desk)"
int    atrLen    = input.int(14, "ATR length (days)", minval = 1, group = G1)
string atrSmooth = input.string("RMA", "Smoothing", options = ["RMA", "EMA", "SMA", "WMA"], group = G1)
string tz        = input.string("America/New_York", "Timezone", group = G1)

string G2 = "Tight box (matches the desk)"
int   tbWin   = input.int(10, "Window (completed daily bars)", minval = 3, maxval = 40, group = G2)
float tbMaxHx = input.float(2.0, "Real box = total height ≤ this × ATR", minval = 0.5, maxval = 5.0, step = 0.25, group = G2, tooltip = "A box only EXISTS when the ticker's whole window fits inside a channel this tall. Wider = NO BOX: no pivots, no alerts for that ticker until it actually consolidates.")
bool  tbRejOn = input.bool(true, "AND no wild bars allowed", group = G2, tooltip = "A day wider than sensitivity × the window's average bar is a wild bar; even one disqualifies the box entirely.")
float tbSens  = input.float(1.8, "Wild bar = range over this × average", minval = 1.3, maxval = 2.5, step = 0.1, group = G2)

string G3 = "Second-entry rules (matches the desk)"
float retracePct  = input.float(30.0, "Retrace % of first push", minval = 10.0, maxval = 80.0, step = 5.0, group = G3, tooltip = "The first push through a box edge is the 1st wave — retail traders being liquidated: they chase the break, and their stops and forced exits produce the retrace, which must give back at least this % of the push (and the ATR floor below). The 2nd wave is institutional money stepping in at better prices and running the stops on the way — the reclaim of the push extreme is the second entry. Long side: institutions buy the pullback cheaper and run the buy stops above. Short side: the same in reverse. The scanner only calls a ticker INSTITUTIONS once the flush has happened.")
float minRetrX    = input.float(0.3, "AND at least this × ATR", minval = 0.1, step = 0.05, group = G3)
float nearX       = input.float(0.15, "NEAR = within this × ATR of second", minval = 0.05, step = 0.05, group = G3)
bool  hourResetIn = input.bool(true, "Hourly: miss the 60, need a new second", group = G3)

string G4 = "Tickers (leave blank to skip)"
string sym1  = input.symbol("", "Ticker 1", group = G4, tooltip = "Type or search the symbol (e.g. NASDAQ:TSLA). Blank rows are skipped. After filling the list, create ONE alert on this scanner with condition = Any alert() function call — that single alert covers every ticker here.")
string sym2  = input.symbol("", "Ticker 2", group = G4)
string sym3  = input.symbol("", "Ticker 3", group = G4)
string sym4  = input.symbol("", "Ticker 4", group = G4)
string sym5  = input.symbol("", "Ticker 5", group = G4)
string sym6  = input.symbol("", "Ticker 6", group = G4)
string sym7  = input.symbol("", "Ticker 7", group = G4)
string sym8  = input.symbol("", "Ticker 8", group = G4)
string sym9  = input.symbol("", "Ticker 9", group = G4)
string sym10 = input.symbol("", "Ticker 10", group = G4)
string sym11 = input.symbol("", "Ticker 11", group = G4)
string sym12 = input.symbol("", "Ticker 12", group = G4)
string sym13 = input.symbol("", "Ticker 13", group = G4)
string sym14 = input.symbol("", "Ticker 14", group = G4)
string sym15 = input.symbol("", "Ticker 15", group = G4)

string G5 = "Display"
string tblPos  = input.string("Top right", "Table position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G5)
string tblSize = input.string("tiny", "Text size", options = ["tiny", "small", "normal"], group = G5)
bool   onlyHot  = input.bool(false, "Only show INSTITUTIONS / ENTRY rows", group = G5, tooltip = "Hides DISTRIBUTION and RETAIL FLUSH rows so the table only lists tickers where a second entry is loaded. The alert still watches every ticker either way — this only trims the table.")
bool   compactOn = input.bool(true, "Compact (single column)", group = G5, tooltip = "Squeezes each ticker to one small cell: TSLA · ARMED L · 366.5. Combine with tiny text for the smallest possible footprint.")

string G6 = "Next stop (measured potential)"
bool nsOn = input.bool(true, "Show next stop on active rows", group = G6, tooltip = "PS60 Rule 1: stocks move supply-to-supply / demand-to-demand, and the distance to the next level is the measured potential. For any ticker with a direction — a box break, or price confirmed past the prior day's high/low — the row shows the nearest meaningful level in that direction: the daily EMA stack (4/9/10/13/20/50/65/89/100/200, prior completed day, static all session), PDH/PDL, the remaining-ATR ladder, and whole numbers. Levels stacking within 0.15×ATR merge into one zone and the row shows how many agree (+1, +2…). Levels hugging price (within 0.10×ATR) are skipped. THIN = less than 0.25×ATR of room — not worth it, especially on options. ↑/↓bias = which side of its daily 50 SMA the stock is on. Display-only for now; no alerts fire from this.")

// ───────── Helpers ─────────
f2(float v) => math.round(v * 100.0) / 100.0

f_atr() =>
    trv = ta.tr(true)
    switch atrSmooth
        "EMA" => ta.ema(trv, atrLen)
        "SMA" => ta.sma(trv, atrLen)
        "WMA" => ta.wma(trv, atrLen)
        => ta.rma(trv, atrLen)

f_tightCalc() =>
    float[] rngs = array.new_float()
    for i = 1 to tbWin
        array.push(rngs, high[i] - low[i])
    float avgR = array.avg(rngs)
    int wildN = 0
    for i = 1 to tbWin
        if high[i] - low[i] > tbSens * avgR
            wildN += 1
    float hh = ta.highest(high, tbWin)[1]
    float ll = ta.lowest(low, tbWin)[1]
    [hh, ll, wildN]

f_stepAuto(float p) =>
    p >= 200 ? 5.0 : p >= 80 ? 1.0 : 0.5

f_addLv(float[] lp, string[] ln, float v, string nm) =>
    if not na(v)
        array.push(lp, v)
        array.push(ln, nm)

// Daily pull: ATR + prev close + tight box + the full daily EMA stack (prior
// COMPLETED day via [1], so every level is static all session) + daily 50 SMA
// for the bias tag + prior day high/low.
f_dailyScan() =>
    [tbh, tbl, tbw] = f_tightCalc()
    [f_atr()[1], close[1], tbh, tbl, tbw, ta.ema(close, 4)[1], ta.ema(close, 9)[1], ta.ema(close, 10)[1], ta.ema(close, 13)[1], ta.ema(close, 20)[1], ta.ema(close, 50)[1], ta.ema(close, 65)[1], ta.ema(close, 89)[1], ta.ema(close, 100)[1], ta.ema(close, 200)[1], ta.sma(close, 50)[1], high[1], low[1]]

// Runs inside each ticker's own 5-minute context. State codes:
// 0 building/no box · 1 WAIT · 2 THROUGH (wait retrace) · 3 ARMED · 4 NEAR
// cont: 1 = confirmed over prior day high, -1 = under prior day low, 0 = neither
f_scan() =>
    [dAtr, dPrevC, tbh, tbl, tbw, e4, e9, e10, e13, e20, e50, e65, e89, e100, e200, s50d, pdhV, pdlV] = request.security(syminfo.tickerid, "D", f_dailyScan(), barmerge.gaps_off, barmerge.lookahead_on)
    float htX = not na(tbh) and not na(tbl) and not na(dAtr) and dAtr > 0 ? (tbh - tbl) / dAtr : na
    var bool   seThru   = false
    var int    seSide   = 0
    var float  sePivot  = na
    var float  seExt    = na
    var bool   sePulled = false
    var int    dk       = na
    var int    lastHr   = na
    var float  dHi      = na
    var float  dLo      = na
    int bk = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
    if na(dk) or bk != dk
        seThru   := false
        seSide   := 0
        sePivot  := na
        seExt    := na
        sePulled := false
        dHi      := na
        dLo      := na
        dk       := bk
    int hr = hour(time, tz)
    if hourResetIn and not na(lastHr) and hr != lastHr
        seExt    := na
        sePulled := false
    lastHr := hr
    bool rth = not na(time("", "0930-1600", tz))
    if rth
        dHi := na(dHi) ? high : math.max(dHi, high)
        dLo := na(dLo) ? low : math.min(dLo, low)
    bool boxOK = not na(htX) and htX <= tbMaxHx and (not tbRejOn or tbw == 0)
    if rth and boxOK
        if not seThru
            if high > tbh
                seThru  := true
                seSide  := 1
                sePivot := tbh
                seExt   := high
            else if low < tbl
                seThru  := true
                seSide  := -1
                sePivot := tbl
                seExt   := low
        else
            float floorR = minRetrX * dAtr
            if seSide == 1
                seExt := na(seExt) ? high : math.max(seExt, high)
                float push = seExt - sePivot
                float need = math.max(push * retracePct / 100.0, floorR)
                if not sePulled and push > 0 and need > 0 and low <= seExt - need
                    sePulled := true
            else
                seExt := na(seExt) ? low : math.min(seExt, low)
                float push = sePivot - seExt
                float need = math.max(push * retracePct / 100.0, floorR)
                if not sePulled and push > 0 and need > 0 and high >= seExt + need
                    sePulled := true
    bool near = sePulled and not na(seExt) and boxOK and math.abs(close - seExt) <= nearX * dAtr
    int st = not boxOK ? 0 : not seThru ? 1 : not sePulled ? 2 : near ? 4 : 3
    // continuation watch: no box needed — price confirmed past the prior day's range
    // confirmed = the PRIOR completed bar closed beyond the prior day's level
    int cont = rth and not na(pdhV) and close[1] > pdhV and close > pdhV ? 1 : rth and not na(pdlV) and close[1] < pdlV and close < pdlV ? -1 : 0
    // ── next stop: nearest meaningful level in trade direction ──
    string tgtS = ""
    int dir = seThru ? seSide : cont
    if nsOn and dir != 0 and not na(dAtr) and dAtr > 0
        float[] lvP = array.new_float()
        string[] lvN = array.new_string()
        f_addLv(lvP, lvN, e4, "EMA4 D")
        f_addLv(lvP, lvN, e9, "EMA9 D")
        f_addLv(lvP, lvN, e10, "EMA10 D")
        f_addLv(lvP, lvN, e13, "EMA13 D")
        f_addLv(lvP, lvN, e20, "EMA20 D")
        f_addLv(lvP, lvN, e50, "EMA50 D")
        f_addLv(lvP, lvN, e65, "EMA65 D")
        f_addLv(lvP, lvN, e89, "EMA89 D")
        f_addLv(lvP, lvN, e100, "EMA100 D")
        f_addLv(lvP, lvN, e200, "EMA200 D")
        f_addLv(lvP, lvN, pdhV, "PDH")
        f_addLv(lvP, lvN, pdlV, "PDL")
        if not na(dHi) and not na(dLo)
            float usedD = not na(dPrevC) ? math.max(dHi - dLo, math.abs(dHi - dPrevC), math.abs(dLo - dPrevC)) : dHi - dLo
            float rem1 = 1.0 * dAtr - usedD
            float rem15 = 1.5 * dAtr - usedD
            float rem2 = 2.0 * dAtr - usedD
            float rem25 = 2.5 * dAtr - usedD
            float rem3 = 3.0 * dAtr - usedD
            f_addLv(lvP, lvN, rem1 > 0 ? dHi + rem1 : na, "1x ATR")
            f_addLv(lvP, lvN, rem15 > 0 ? dHi + rem15 : na, "1.5x ATR")
            f_addLv(lvP, lvN, rem2 > 0 ? dHi + rem2 : na, "2x ATR")
            f_addLv(lvP, lvN, rem25 > 0 ? dHi + rem25 : na, "2.5x ATR")
            f_addLv(lvP, lvN, rem3 > 0 ? dHi + rem3 : na, "3x ATR")
            f_addLv(lvP, lvN, rem1 > 0 ? dLo - rem1 : na, "1x ATR")
            f_addLv(lvP, lvN, rem15 > 0 ? dLo - rem15 : na, "1.5x ATR")
            f_addLv(lvP, lvN, rem2 > 0 ? dLo - rem2 : na, "2x ATR")
            f_addLv(lvP, lvN, rem25 > 0 ? dLo - rem25 : na, "2.5x ATR")
            f_addLv(lvP, lvN, rem3 > 0 ? dLo - rem3 : na, "3x ATR")
        float wStep = f_stepAuto(close)
        f_addLv(lvP, lvN, math.ceil(close / wStep) * wStep, "whole")
        f_addLv(lvP, lvN, math.floor(close / wStep) * wStep, "whole")
        float best = na
        string bestN = ""
        for j = 0 to array.size(lvP) - 1
            float pv = array.get(lvP, j)
            bool okDir = dir > 0 ? pv > close + 0.10 * dAtr : pv < close - 0.10 * dAtr
            if okDir and (na(best) or (dir > 0 ? pv < best : pv > best))
                best := pv
                bestN := array.get(lvN, j)
        if not na(best)
            int cnt = 0
            for j = 0 to array.size(lvP) - 1
                if math.abs(array.get(lvP, j) - best) <= 0.15 * dAtr
                    cnt += 1
            float dist = math.abs(best - close)
            bool thin = dist < 0.25 * dAtr
            tgtS := "→ " + str.tostring(f2(best)) + " (" + bestN + (cnt > 1 ? " +" + str.tostring(cnt - 1) : "") + ") $" + str.tostring(f2(dist)) + (thin ? " · THIN" : "") + (not na(s50d) ? close > s50d ? " · ↑bias" : " · ↓bias" : "")
    [st, seSide, tbh, tbl, seExt, tbw, htX, cont, tgtS, pdhV, pdlV]

// ───────── Chart-timeframe guard ─────────
// The chart drives every calculation. On a chart slower than 5 minutes the
// per-ticker engines get too few samples and their states are wrong, so the
// scanner pauses and says so instead of showing bad rows.
bool tfOK = timeframe.isintraday and timeframe.in_seconds(timeframe.period) <= 300

// ───────── One data pull per ticker ─────────
[st1, sd1, bh1, bl1, ex1, wd1, hx1, cn1, ts1, ph1, pl1] = request.security(sym1 == "" ? syminfo.tickerid : sym1, "5", f_scan(), barmerge.gaps_off, barmerge.lookahead_off)
[st2, sd2, bh2, bl2, ex2, wd2, hx2, cn2, ts2, ph2, pl2] = request.security(sym2 == "" ? syminfo.tickerid : sym2, "5", f_scan(), barmerge.gaps_off, barmerge.lookahead_off)
[st3, sd3, bh3, bl3, ex3, wd3, hx3, cn3, ts3, ph3, pl3] = request.security(sym3 == "" ? syminfo.tickerid : sym3, "5", f_scan(), barmerge.gaps_off, barmerge.lookahead_off)
[st4, sd4, bh4, bl4, ex4, wd4, hx4, cn4, ts4, ph4, pl4] = request.security(sym4 == "" ? syminfo.tickerid : sym4, "5", f_scan(), barmerge.gaps_off, barmerge.lookahead_off)
[st5, sd5, bh5, bl5, ex5, wd5, hx5, cn5, ts5, ph5, pl5] = request.security(sym5 == "" ? syminfo.tickerid : sym5, "5", f_scan(), barmerge.gaps_off, barmerge.lookahead_off)
[st6, sd6, bh6, bl6, ex6, wd6, hx6, cn6, ts6, ph6, pl6] = request.security(sym6 == "" ? syminfo.tickerid : sym6, "5", f_scan(), barmerge.gaps_off, barmerge.lookahead_off)
[st7, sd7, bh7, bl7, ex7, wd7, hx7, cn7, ts7, ph7, pl7] = request.security(sym7 == "" ? syminfo.tickerid : sym7, "5", f_scan(), barmerge.gaps_off, barmerge.lookahead_off)
[st8, sd8, bh8, bl8, ex8, wd8, hx8, cn8, ts8, ph8, pl8] = request.security(sym8 == "" ? syminfo.tickerid : sym8, "5", f_scan(), barmerge.gaps_off, barmerge.lookahead_off)
[st9, sd9, bh9, bl9, ex9, wd9, hx9, cn9, ts9, ph9, pl9] = request.security(sym9 == "" ? syminfo.tickerid : sym9, "5", f_scan(), barmerge.gaps_off, barmerge.lookahead_off)
[st10, sd10, bh10, bl10, ex10, wd10, hx10, cn10, ts10, ph10, pl10] = request.security(sym10 == "" ? syminfo.tickerid : sym10, "5", f_scan(), barmerge.gaps_off, barmerge.lookahead_off)
[st11, sd11, bh11, bl11, ex11, wd11, hx11, cn11, ts11, ph11, pl11] = request.security(sym11 == "" ? syminfo.tickerid : sym11, "5", f_scan(), barmerge.gaps_off, barmerge.lookahead_off)
[st12, sd12, bh12, bl12, ex12, wd12, hx12, cn12, ts12, ph12, pl12] = request.security(sym12 == "" ? syminfo.tickerid : sym12, "5", f_scan(), barmerge.gaps_off, barmerge.lookahead_off)
[st13, sd13, bh13, bl13, ex13, wd13, hx13, cn13, ts13, ph13, pl13] = request.security(sym13 == "" ? syminfo.tickerid : sym13, "5", f_scan(), barmerge.gaps_off, barmerge.lookahead_off)
[st14, sd14, bh14, bl14, ex14, wd14, hx14, cn14, ts14, ph14, pl14] = request.security(sym14 == "" ? syminfo.tickerid : sym14, "5", f_scan(), barmerge.gaps_off, barmerge.lookahead_off)
[st15, sd15, bh15, bl15, ex15, wd15, hx15, cn15, ts15, ph15, pl15] = request.security(sym15 == "" ? syminfo.tickerid : sym15, "5", f_scan(), barmerge.gaps_off, barmerge.lookahead_off)

// ───────── Alerts: one alert() covers every ticker ─────────
f_name(string s) =>
    string[] parts = str.split(s, ":")
    array.get(parts, array.size(parts) - 1)

f_fire(string s, int st, int sd, float ex) =>
    if tfOK and s != "" and st == 4
        alert(f_name(s) + " second entry · " + (sd > 0 ? "LONG" : "SHORT") + " · trigger " + str.tostring(f2(ex)), alert.freq_once_per_bar)

f_fire(sym1, st1, sd1, ex1)
f_fire(sym2, st2, sd2, ex2)
f_fire(sym3, st3, sd3, ex3)
f_fire(sym4, st4, sd4, ex4)
f_fire(sym5, st5, sd5, ex5)
f_fire(sym6, st6, sd6, ex6)
f_fire(sym7, st7, sd7, ex7)
f_fire(sym8, st8, sd8, ex8)
f_fire(sym9, st9, sd9, ex9)
f_fire(sym10, st10, sd10, ex10)
f_fire(sym11, st11, sd11, ex11)
f_fire(sym12, st12, sd12, ex12)
f_fire(sym13, st13, sd13, ex13)
f_fire(sym14, st14, sd14, ex14)
f_fire(sym15, st15, sd15, ex15)

// ───────── Table ─────────
var table scanT = table.new(tblPos == "Top left" ? position.top_left : tblPos == "Bottom right" ? position.bottom_right : tblPos == "Bottom left" ? position.bottom_left : position.top_right, 3, 17, border_width = 1, border_color = color.new(color.white, 70))

if barstate.islast
    string tsz = tblSize == "tiny" ? size.tiny : tblSize == "normal" ? size.normal : size.small
    table.clear(scanT, 0, 0, 2, 16)
    if not tfOK
        table.cell(scanT, 0, 0, "SCANNER PAUSED — set this chart to 5 minutes (or faster)", bgcolor = color.new(#ef5350, 0), text_color = color.white, text_size = tsz)
    else if not compactOn
        table.cell(scanT, 0, 0, "TICKER", bgcolor = color.new(#6a1b9a, 0), text_color = color.white, text_size = tsz)
        table.cell(scanT, 1, 0, "STATUS", bgcolor = color.new(#6a1b9a, 0), text_color = color.white, text_size = tsz)
        table.cell(scanT, 2, 0, "LEVEL", bgcolor = color.new(#6a1b9a, 0), text_color = color.white, text_size = tsz)
    string[] symA = array.from(sym1, sym2, sym3, sym4, sym5, sym6, sym7, sym8, sym9, sym10, sym11, sym12, sym13, sym14, sym15)
    int[] stA = array.from(st1, st2, st3, st4, st5, st6, st7, st8, st9, st10, st11, st12, st13, st14, st15)
    int[] sdA = array.from(sd1, sd2, sd3, sd4, sd5, sd6, sd7, sd8, sd9, sd10, sd11, sd12, sd13, sd14, sd15)
    float[] bhA = array.from(bh1, bh2, bh3, bh4, bh5, bh6, bh7, bh8, bh9, bh10, bh11, bh12, bh13, bh14, bh15)
    float[] blA = array.from(bl1, bl2, bl3, bl4, bl5, bl6, bl7, bl8, bl9, bl10, bl11, bl12, bl13, bl14, bl15)
    float[] exA = array.from(ex1, ex2, ex3, ex4, ex5, ex6, ex7, ex8, ex9, ex10, ex11, ex12, ex13, ex14, ex15)
    int[] wdA = array.from(wd1, wd2, wd3, wd4, wd5, wd6, wd7, wd8, wd9, wd10, wd11, wd12, wd13, wd14, wd15)
    float[] hxA = array.from(hx1, hx2, hx3, hx4, hx5, hx6, hx7, hx8, hx9, hx10, hx11, hx12, hx13, hx14, hx15)
    int[] cnA = array.from(cn1, cn2, cn3, cn4, cn5, cn6, cn7, cn8, cn9, cn10, cn11, cn12, cn13, cn14, cn15)
    string[] tsA = array.from(ts1, ts2, ts3, ts4, ts5, ts6, ts7, ts8, ts9, ts10, ts11, ts12, ts13, ts14, ts15)
    float[] phA = array.from(ph1, ph2, ph3, ph4, ph5, ph6, ph7, ph8, ph9, ph10, ph11, ph12, ph13, ph14, ph15)
    float[] plA = array.from(pl1, pl2, pl3, pl4, pl5, pl6, pl7, pl8, pl9, pl10, pl11, pl12, pl13, pl14, pl15)
    int rIdx = compactOn ? 0 : 1
    int activeN = 0
    int shownN = 0
    for i = 0 to 14
        string s = array.get(symA, i)
        if tfOK and s != ""
            activeN += 1
            int st = array.get(stA, i)
            if not (onlyHot and st < 3)
                shownN += 1
                int sd = array.get(sdA, i)
                string sideTag = sd > 0 ? "L" : sd < 0 ? "S" : ""
                int cn = array.get(cnA, i)
                string ts = array.get(tsA, i)
                bool watch = st <= 1 and cn != 0
                string stTxt = watch ? (cn > 0 ? "BREAKOUT WATCH ▲ over " + str.tostring(f2(array.get(phA, i))) : "BREAKDOWN WATCH ▼ under " + str.tostring(f2(array.get(plA, i)))) : st == 0 ? "NO BOX" : st == 1 ? "DISTRIBUTION" : st == 2 ? "RETAIL FLUSH " + (sd > 0 ? "▲" : "▼") : st == 3 ? "INSTITUTIONS " + sideTag : "ENTRY " + sideTag
                color stBg = st == 4 ? color.new(#6a1b9a, 0) : st == 3 ? color.new(#26a69a, 0) : st == 2 ? color.new(#ffd500, 10) : watch ? color.new(#ef6c00, 10) : color.new(color.black, 30)
                color stTx = st == 3 or st == 4 ? color.white : st == 2 ? color.black : watch ? color.white : color.new(#b2b5be, 0)
                string lvlTxt = ""
                if st == 0
                    int wd = array.get(wdA, i)
                    float hx = array.get(hxA, i)
                    lvlTxt := na(hx) ? "building…" : tbRejOn and wd > 0 ? str.tostring(wd) + " wild bar" + (wd > 1 ? "s" : "") : "range " + str.tostring(f2(hx)) + "x ATR > " + str.tostring(tbMaxHx) + "x"
                else if st == 1
                    lvlTxt := "box " + str.tostring(f2(array.get(bhA, i))) + " / " + str.tostring(f2(array.get(blA, i)))
                else if st == 2
                    lvlTxt := "push " + str.tostring(f2(array.get(exA, i))) + " · liquidation, wait"
                else
                    lvlTxt := "trigger " + str.tostring(f2(array.get(exA, i)))
                if watch
                    lvlTxt := ts != "" ? ts : "→ no level in range"
                else if nsOn and ts != "" and st >= 2
                    lvlTxt := lvlTxt + " " + ts
                if compactOn
                    table.cell(scanT, 0, rIdx, f_name(s) + " · " + stTxt + " · " + lvlTxt, bgcolor = stBg, text_color = stTx, text_size = tsz)
                else
                    table.cell(scanT, 0, rIdx, f_name(s), bgcolor = color.new(color.black, 30), text_color = color.white, text_size = tsz)
                    table.cell(scanT, 1, rIdx, stTxt, bgcolor = stBg, text_color = stTx, text_size = tsz)
                    table.cell(scanT, 2, rIdx, lvlTxt, bgcolor = color.new(color.black, 30), text_color = color.new(#b2b5be, 0), text_size = tsz)
                rIdx += 1
    if tfOK and activeN == 0
        table.cell(scanT, 0, compactOn ? 0 : 1, "Add tickers in settings", bgcolor = color.new(color.black, 30), text_color = color.new(#ffd54f, 0), text_size = tsz)
    else if tfOK and onlyHot and shownN == 0
        table.cell(scanT, 0, compactOn ? 0 : 1, "watching " + str.tostring(activeN) + " · none armed", bgcolor = color.new(color.black, 30), text_color = color.new(#b2b5be, 0), text_size = tsz)
