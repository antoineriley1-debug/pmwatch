//@version=5
strategy("PS60 Second-Entry Backtester", "PS60-BT", overlay = false, initial_capital = 25000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, pyramiding = 0, process_orders_on_close = true, calc_on_every_tick = false, max_lines_count = 50, max_labels_count = 50)

// Companion to PS60 Desk+. SEPARATE script — lives in its own bottom pane
// (collapse it when you don't need it). It mirrors the desk's rules: auto-pivot
// second entry off the tight-box edges (upper edge = long trigger, lower edge =
// short trigger), remaining ATR as the target filter.
//
// Declared as a STRATEGY so the full Strategy Tester report (profit factor,
// drawdown, trade list) is available under the Strategy Tester tab, on top of
// the custom stats table drawn in this pane.
//
// KNOWN LIMIT: TradingView requires strategy orders to execute on the chart's
// own bars, so the TRADE sample here is capped by the chart's loaded 5-minute
// history (roughly 100 trading days). This is a platform constraint on
// strategies, not a bug — the desk's probability sample escapes it via a data
// pull, but simulated trades cannot. Scrolling the chart LEFT loads more days.
//
// Fills are modeled at bar close on the signal bar — good enough for hit-rate
// work, not a substitute for live fills.

// ───────── Inputs ─────────
string G1 = "ATR (matches the desk)"
int    atrLen    = input.int(14, "ATR length (days)", minval = 1, group = G1, tooltip = "Same convention as PS60 Desk+: prior COMPLETED day, static all session.")
string atrSmooth = input.string("RMA", "Smoothing", options = ["RMA", "EMA", "SMA", "WMA"], group = G1)
string tz        = input.string("America/New_York", "Timezone", group = G1)

string G2 = "Tight box (matches the desk)"
int   tbWin   = input.int(10, "Window (completed daily bars)", minval = 3, maxval = 40, group = G2, tooltip = "Completed days only, so the edges are static — the same edges the desk uses for its auto-pivot.")
float tbMaxHx = input.float(2.0, "Real box = total height ≤ this × ATR", minval = 0.5, maxval = 5.0, step = 0.25, group = G2, tooltip = "A box only EXISTS when the whole window fits inside a channel this tall — same qualification rule as the desk and scanner. Wider = NO BOX, no trades that day.")
bool  tbRejOn = input.bool(true, "AND no wild bars allowed", group = G2, tooltip = "A day wider than sensitivity × the window's average bar is a wild bar; even one disqualifies the box entirely (no trimming).")
float tbSens  = input.float(1.8, "Wild bar = range over this × average", minval = 1.3, maxval = 2.5, step = 0.1, group = G2)

string G3 = "Second-entry rules"
string sideMode   = input.string("Both", "Side", options = ["Both", "Long only", "Short only"], group = G3)
float  retracePct = input.float(30.0, "Retrace % of first push", minval = 10.0, maxval = 80.0, step = 5.0, group = G3, tooltip = "After price breaks a box edge, it must pull back at least this % of the first push (and at least the ATR floor below) before a second entry can arm.")
float  minRetrX   = input.float(0.3, "AND at least this × ATR", minval = 0.1, step = 0.05, group = G3)
float  targetX    = input.float(1.0, "Target (× ATR of total day travel)", minval = 0.5, step = 0.1, group = G3, tooltip = "The profit target is the remaining-ATR level: today's high (for longs) plus whatever is left of targetX × ATR at entry time. Same ladder the desk draws.")
float  minLeftX   = input.float(0.25, "Skip if less than this × ATR of room to target", minval = 0.0, step = 0.05, group = G3, tooltip = "The remaining-ATR filter: a second entry with almost no gas left to the target is not taken.")
bool   hourReset  = input.bool(true, "Hourly: miss the 60, need a new second", group = G3)
int    maxPerDay  = input.int(2, "Max trades per day", minval = 1, maxval = 6, group = G3)
int    lastEntryMin = input.int(330, "No new entries after (minutes past 9:30)", minval = 60, maxval = 380, group = G3, tooltip = "330 = 3:00 PM. Late-day entries have no time to work.")
bool   eodOn      = input.bool(true, "Close everything at 3:55 PM", group = G3)
bool   finOn      = input.bool(true, "Finance the trade: half off at first move, stop to breakeven", group = G3, tooltip = "PS60 Rule 3. Half the position exits at the first-scale distance below; once that fills, the stop on the rest moves to the entry price (a free trade) and the runner rides to the remaining-ATR target. Turn off to test the plain all-or-nothing bracket instead.")
float  scale1X    = input.float(0.5, "First scale at (× ATR beyond entry)", minval = 0.1, maxval = 1.0, step = 0.05, group = G3)
bool   fastOut    = input.bool(true, "5-7 minute rule: scratch if it does not move", group = G3, tooltip = "If the trade has not traveled at least the amount below within the minutes below, there is likely a reload buyer/seller at the level — exit and take the scratch. Checked on bar closes, so on a 5-minute chart the check lands on the first bar close at or past the limit.")
int    fastMins   = input.int(7, "Scratch after (minutes)", minval = 5, maxval = 20, group = G3)
float  fastMoveX  = input.float(0.05, "…unless it moved this × ATR", minval = 0.0, maxval = 0.3, step = 0.01, group = G3)
bool   quietOpen  = input.bool(false, "No entries before 10:00", group = G3, tooltip = "PS60 open discipline: let the first hour form before taking entries.")

string G0 = "Stats table"
string tblPosIn = input.string("Top right", "Position on the chart", options = ["Top left", "Top center", "Top right", "Middle left", "Middle center", "Middle right", "Bottom left", "Bottom center", "Bottom right"], group = G0)
string tblSizeIn = input.string("Compact", "Text size", options = ["Compact", "Medium", "Large", "Huge"], group = G0)

string G4 = "Read me"
bool noteA = input.bool(true, "ℹ Small-sample warning (read this tooltip)", group = G4, tooltip = "TradingView requires strategy trades to execute on the chart's own bars, so this backtest is capped by the chart's loaded 5-minute history (roughly 100 trading days) — a platform constraint on strategies, which is why the desk's probability sample can reach further back but simulated trades cannot. Scroll the chart LEFT — as older bars load in, they join the test automatically. The stats table shows exactly how many days and trades the numbers come from. Treat anything under ~30 trades as a sketch, not a verdict.")

// ───────── ATR + tight box from completed daily bars ─────────
f_atr() =>
    trv = ta.tr(true)
    switch atrSmooth
        "EMA" => ta.ema(trv, atrLen)
        "SMA" => ta.sma(trv, atrLen)
        "WMA" => ta.wma(trv, atrLen)
        => ta.rma(trv, atrLen)

f_tightCalc() =>
    float[] rngs = array.new_float()
    for i = 1 to tbWin
        array.push(rngs, high[i] - low[i])
    float avgR = array.avg(rngs)
    int wildN = 0
    for i = 1 to tbWin
        if high[i] - low[i] > tbSens * avgR
            wildN += 1
    float hh = ta.highest(high, tbWin)[1]
    float ll = ta.lowest(low, tbWin)[1]
    [hh, ll, wildN]

f_daily() =>
    float a = f_atr()[1]
    [tbh, tbl, tbw] = f_tightCalc()
    [a, close[1], tbh, tbl, tbw]

[yATR, prevC, tbHi, tbLo, tbWild] = request.security(syminfo.tickerid, "D", f_daily(), barmerge.gaps_off, barmerge.lookahead_off)

f2(float v) => math.round(v * 100.0) / 100.0

f_fmtKey(int k) =>
    int y = math.round(math.floor(k / 10000.0))
    int m = math.round(math.floor(k / 100.0)) % 100
    int d = k % 100
    string mn = m == 1 ? "Jan" : m == 2 ? "Feb" : m == 3 ? "Mar" : m == 4 ? "Apr" : m == 5 ? "May" : m == 6 ? "Jun" : m == 7 ? "Jul" : m == 8 ? "Aug" : m == 9 ? "Sep" : m == 10 ? "Oct" : m == 11 ? "Nov" : "Dec"
    mn + " " + str.tostring(d) + " '" + str.tostring(y % 100)

// ───────── Session plumbing ─────────
// Day rollover keys off the calendar date of each bar (works with or without
// extended hours). Day range seeds from RTH bars only.
int sessStart   = timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), 9, 30)
float minsSince = (time - sessStart) / 60000.0
bool rthBar = not na(time(timeframe.period, "0930-1600", tz))
int barKey = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)

var int dayKey = na
bool newSess = na(dayKey) or barKey != dayKey

var float rHi = na
var float rLo = na
var int   tradesToday = 0
var int   daysN = 0
var int   firstKeyBT = na
var int   rthDayKey = na

if newSess
    rHi := na
    rLo := na
    tradesToday := 0
    dayKey := barKey

if rthBar
    rHi := na(rHi) ? high : math.max(rHi, high)
    rLo := na(rLo) ? low : math.min(rLo, low)
    if na(rthDayKey) or barKey != rthDayKey
        daysN += 1
        rthDayKey := barKey
        if na(firstKeyBT)
            firstKeyBT := barKey

float usedNow = not na(rHi) and not na(rLo) and not na(prevC) ? math.max(rHi - rLo, math.abs(rHi - prevC), math.abs(rLo - prevC)) : na

// ───────── Second-entry engine (mirrors the desk) ─────────
var bool   seThru   = false
var string seSide   = "Long"
var float  sePivot  = na
var float  seExt    = na
var bool   sePulled = false
var float  pbExt    = na

float tbHtX = not na(tbHi) and not na(tbLo) and not na(yATR) and yATR > 0 ? (tbHi - tbLo) / yATR : na
bool tbOK = not na(tbHtX) and tbHtX <= tbMaxHx and (not tbRejOn or tbWild == 0)

if newSess
    seThru   := false
    sePivot  := na
    seExt    := na
    sePulled := false
    pbExt    := na

int  hourT = request.security(syminfo.tickerid, "60", time, barmerge.gaps_off, barmerge.lookahead_off)
bool newHour = not na(hourT) and ta.change(hourT) != 0
if hourReset and newHour
    seExt    := na
    sePulled := false
    pbExt    := na

// trade bookkeeping for the custom stats
var float entryQty = na
var bool  movedBE  = false
var int   entBar   = na
var bool  wasScratch = false
var int   nScratch = 0
int barMins = math.max(1, math.round(timeframe.in_seconds() / 60))
var float tEntry = na
var float tTgt   = na
var float tStop  = na
var float tMax   = na
var float tATR   = na
var bool  tLong  = true
var float lastPiv   = na
var float lastPush  = na
var float lastPullP = na
var float lastInP   = na
var float lastTgtP  = na
var bool  lastLong  = true
var int   nHit   = 0
var int   nFake  = 0
var int   nRes   = 0
var float runSum = 0.0

bool flatNow = strategy.position_size == 0
bool canEnter = flatNow and rthBar and tbOK and not na(usedNow) and minsSince >= (quietOpen ? 30 : 0) and minsSince <= lastEntryMin and tradesToday < maxPerDay
bool allowLong  = sideMode != "Short only"
bool allowShort = sideMode != "Long only"

if rthBar and tbOK
    if not seThru
        if allowLong and high > tbHi
            seThru   := true
            seSide   := "Long"
            sePivot  := tbHi
            seExt    := high
            sePulled := false
            pbExt    := na
        else if allowShort and low < tbLo
            seThru   := true
            seSide   := "Short"
            sePivot  := tbLo
            seExt    := low
            sePulled := false
            pbExt    := na
    else
        float floorR = minRetrX * yATR
        if seSide == "Long"
            // second entry: after the retrace, price reclaims the push high
            if sePulled and canEnter and high > seExt
                float room = targetX * yATR - usedNow
                float tgtPx = rHi + math.max(room, 0.0)
                if room >= minLeftX * yATR and tgtPx > close and not na(pbExt) and pbExt < close
                    strategy.entry("L", strategy.long)
                    if finOn
                        strategy.exit("Lx1", "L", qty_percent = 50, stop = pbExt, limit = close + scale1X * yATR)
                        strategy.exit("Lx2", "L", qty_percent = 100, stop = pbExt, limit = tgtPx)
                    else
                        strategy.exit("Lx", "L", stop = pbExt, limit = tgtPx)
                    lastPiv   := sePivot
                    lastPush  := seExt
                    lastPullP := pbExt
                    lastInP   := close
                    lastTgtP  := tgtPx
                    lastLong  := true
                    tEntry := close
                    tTgt   := tgtPx
                    tStop  := pbExt
                    tMax   := 0.0
                    tATR   := yATR
                    tLong  := true
                    tradesToday += 1
                sePulled := false
                pbExt    := na
            seExt := na(seExt) ? high : math.max(seExt, high)
            float push = seExt - sePivot
            float need = math.max(push * retracePct / 100.0, floorR)
            if not sePulled and push > 0 and need > 0 and low <= seExt - need
                sePulled := true
                pbExt    := low
            else if sePulled
                pbExt := na(pbExt) ? low : math.min(pbExt, low)
        else
            if sePulled and canEnter and low < seExt
                float room = targetX * yATR - usedNow
                float tgtPx = rLo - math.max(room, 0.0)
                if room >= minLeftX * yATR and tgtPx < close and not na(pbExt) and pbExt > close
                    strategy.entry("S", strategy.short)
                    if finOn
                        strategy.exit("Sx1", "S", qty_percent = 50, stop = pbExt, limit = close - scale1X * yATR)
                        strategy.exit("Sx2", "S", qty_percent = 100, stop = pbExt, limit = tgtPx)
                    else
                        strategy.exit("Sx", "S", stop = pbExt, limit = tgtPx)
                    lastPiv   := sePivot
                    lastPush  := seExt
                    lastPullP := pbExt
                    lastInP   := close
                    lastTgtP  := tgtPx
                    lastLong  := false
                    tEntry := close
                    tTgt   := tgtPx
                    tStop  := pbExt
                    tMax   := 0.0
                    tATR   := yATR
                    tLong  := false
                    tradesToday += 1
                sePulled := false
                pbExt    := na
            seExt := na(seExt) ? low : math.min(seExt, low)
            float push = sePivot - seExt
            float need = math.max(push * retracePct / 100.0, floorR)
            if not sePulled and push > 0 and need > 0 and high >= seExt + need
                sePulled := true
                pbExt    := high
            else if sePulled
                pbExt := na(pbExt) ? high : math.max(pbExt, high)

// track max favorable excursion while in a trade
if strategy.position_size != 0 and not na(tEntry)
    tMax := math.max(tMax, tLong ? high - tEntry : tEntry - low)

if strategy.position_size != 0 and na(entryQty)
    entryQty := strategy.position_size
    entBar := bar_index

// Rule 3: after the first scale fills, the rest becomes a free trade
if finOn and not movedBE and not na(entryQty) and strategy.position_size != 0 and math.abs(strategy.position_size) < math.abs(entryQty)
    if tLong
        strategy.exit("Lx2", "L", qty_percent = 100, stop = tEntry, limit = tTgt)
    else
        strategy.exit("Sx2", "S", qty_percent = 100, stop = tEntry, limit = tTgt)
    movedBE := true

// 5-7 minute rule: no movement fast means a reload on the other side
if fastOut and strategy.position_size != 0 and not na(entBar) and not na(tATR) and (bar_index - entBar) * barMins >= fastMins and tMax < fastMoveX * tATR
    wasScratch := true
    strategy.close_all(comment = "5-7 min scratch")

// end-of-day flat
if eodOn and rthBar and minsSince >= 385 and strategy.position_size != 0
    strategy.close_all(comment = "EOD")

// resolve custom stats when a trade closes
bool closedNow = strategy.position_size == 0 and strategy.position_size[1] != 0
if closedNow and not na(tEntry)
    float dist = math.abs(tTgt - tEntry)
    bool hitT = dist > 0 and tMax >= dist * 0.999
    if hitT
        nHit += 1
    else if tMax < 0.5 * dist
        nFake += 1
    runSum += tATR > 0 ? tMax / tATR : 0.0
    nRes += 1
    if wasScratch
        nScratch += 1
    wasScratch := false
    entryQty := na
    movedBE := false
    entBar := na
    tEntry := na

// ───────── Stats table + pane plot ─────────
plot(strategy.equity, "Equity", color.new(#4deeea, 0), 2)

f_tblPos() =>
    switch tblPosIn
        "Top left"      => position.top_left
        "Top center"    => position.top_center
        "Top right"     => position.top_right
        "Middle left"   => position.middle_left
        "Middle center" => position.middle_center
        "Middle right"  => position.middle_right
        "Bottom left"   => position.bottom_left
        "Bottom center" => position.bottom_center
        => position.bottom_right
string szBody = tblSizeIn == "Compact" ? size.tiny : tblSizeIn == "Medium" ? size.small : tblSizeIn == "Large" ? size.normal : size.large
string szHead = tblSizeIn == "Compact" ? size.small : tblSizeIn == "Medium" ? size.normal : tblSizeIn == "Large" ? size.large : size.huge
var table t = table.new(f_tblPos(), 1, 10, border_width = 1, border_color = color.new(color.white, 60))

if barstate.islast
    table.clear(t, 0, 0, 0, 9)
    int closedT = strategy.closedtrades
    int winsT = strategy.wintrades
    string sampleTxt = str.tostring(daysN) + " days loaded, " + (not na(firstKeyBT) ? f_fmtKey(firstKeyBT) : "?") + " – today · " + str.tostring(closedT) + " trades (" + (daysN > 0 ? str.tostring(f2(closedT * 1.0 / daysN)) : "0") + "/day)"
    string wrTxt = closedT > 0 ? "Win rate " + str.tostring(math.round(100.0 * winsT / closedT)) + "%  (" + str.tostring(winsT) + "W / " + str.tostring(closedT - winsT) + "L)" : "No closed trades yet in loaded history"
    string tbTxt = tbOK ? "Tight box today " + str.tostring(f2(tbHi)) + " / " + str.tostring(f2(tbLo)) + " · " + str.tostring(f2(tbHtX)) + "x ATR tall" : na(tbHtX) ? "Tight box building (needs " + str.tostring(tbWin) + " daily bars)" : tbRejOn and tbWild > 0 ? "NO BOX today — " + str.tostring(math.round(tbWild)) + " wild bar(s) in window" : "NO BOX today — range " + str.tostring(f2(tbHtX)) + "x ATR > " + str.tostring(tbMaxHx) + "x limit"
    table.cell(t, 0, 0, "PS60 SECOND-ENTRY BACKTEST", bgcolor = color.new(#6a1b9a, 0), text_color = color.white, text_size = szHead)
    table.cell(t, 0, 1, sampleTxt, bgcolor = color.new(color.black, 20), text_color = color.new(#b2b5be, 0), text_size = szBody)
    table.cell(t, 0, 2, wrTxt, bgcolor = color.new(color.black, 20), text_color = color.white, text_size = szBody)
    int rIdx = 3
    if strategy.grossloss > 0
        table.cell(t, 0, rIdx, "Profit factor " + str.tostring(f2(strategy.grossprofit / strategy.grossloss)), bgcolor = color.new(color.black, 20), text_color = color.white, text_size = szBody)
        rIdx += 1
    else if closedT > 0
        table.cell(t, 0, rIdx, "Profit factor ∞ (no losers yet)", bgcolor = color.new(color.black, 20), text_color = color.white, text_size = szBody)
        rIdx += 1
    if nRes > 0
        table.cell(t, 0, rIdx, "Reached target " + str.tostring(math.round(100.0 * nHit / nRes)) + "%", bgcolor = color.new(color.black, 20), text_color = color.new(#26a69a, 0), text_size = szBody)
        rIdx += 1
        table.cell(t, 0, rIdx, "Typical run " + str.tostring(f2(runSum / nRes)) + "x ATR before exit", bgcolor = color.new(color.black, 20), text_color = color.white, text_size = szBody)
        rIdx += 1
        table.cell(t, 0, rIdx, "Fakeouts " + str.tostring(math.round(100.0 * nFake / nRes)) + "% (stopped before half the target)", bgcolor = color.new(color.black, 20), text_color = color.new(#ef5350, 0), text_size = szBody)
        rIdx += 1
    if fastOut and nScratch > 0
        table.cell(t, 0, rIdx, "Scratches (5-7 min rule): " + str.tostring(nScratch), bgcolor = color.new(color.black, 20), text_color = color.new(#b2b5be, 0), text_size = szBody)
        rIdx += 1
    if not na(lastInP)
        string anat = "Last (" + (lastLong ? "LONG" : "SHORT") + "): pivot " + str.tostring(f2(lastPiv)) + " · flush " + str.tostring(f2(lastPush)) + " · retrace " + str.tostring(f2(lastPullP)) + " · in " + str.tostring(f2(lastInP)) + " · target " + str.tostring(f2(lastTgtP))
        table.cell(t, 0, rIdx, anat, bgcolor = color.new(color.black, 20), text_color = color.new(#4deeea, 0), text_size = szBody)
        rIdx += 1
    table.cell(t, 0, rIdx, timeframe.isintraday ? tbTxt + "  ·  5-min history is limited — scroll left for more days" : "Run this on an intraday chart (5-minute is best)", bgcolor = color.new(#1a1a2e, 10), text_color = color.new(#ffd54f, 0), text_size = szBody)
