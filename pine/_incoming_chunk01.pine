//@version=5
indicator("PS60 Desk+", "DESK+", overlay = true, max_lines_count = 120, max_labels_count = 60, max_boxes_count = 5)

// One ATR feeds everything: tank, levels, second entry, probability.
// ATR = prior COMPLETED day, so levels are static all session. Nothing drifts.
// PROB engine: run on a 5-minute chart for the biggest historical sample.
// ATR levels: live color = still reachable, spent color = traveled. Price always shown.
// Shaded zones between levels, RATR style. Toggle + colors in settings.

// ───────── Inputs ─────────
string G1 = "Tank (ATR)"
int    atrLen    = input.int(14, "ATR length (days)", minval = 1, group = G1)
string atrSmooth = input.string("RMA", "Smoothing", options = ["RMA", "EMA", "SMA", "WMA"], group = G1)
bool   showGas   = input.bool(true, "Gas tank readout", group = G1)
bool   showLvls  = input.bool(true, "Remaining-ATR levels (1x 2x 3x)", group = G1)
bool   showOpen  = input.bool(true, "Today's open line", group = G1)
string tz        = input.string("America/New_York", "Timezone", group = G1)

string G6 = "ATR level colors + shading"
bool  shadeOn = input.bool(true, "Shade zones between levels", group = G6)
color cLive   = input.color(color.new(#26a69a, 0), "Level line: live", group = G6)
color cSpent  = input.color(color.new(#ef5350, 0), "Level line: traveled", group = G6)
color cZ1     = input.color(color.new(#26a69a, 82), "Zone fill: range → 1x", group = G6)
color cZ2     = input.color(color.new(#ffd500, 82), "Zone fill: 1x → 2x", group = G6)
color cZ3     = input.color(color.new(#8a00ff, 86), "Zone fill: 2x → 3x", group = G6)
color cZSpent = input.color(color.new(#ef5350, 82), "Zone fill when traveled", group = G6)

string G2 = "Levels"
bool showPDH   = input.bool(true, "Prev day high", group = G2)
bool showPDL   = input.bool(true, "Prev day low", group = G2)
bool showPDC   = input.bool(true, "Prev day close", group = G2)
bool showPM    = input.bool(true, "Premarket high/low", group = G2)
bool showAH    = input.bool(false, "After-hours high/low", group = G2)
string pmSess  = input.session("0400-0930", "Premarket session", group = G2)
string ahSess  = input.session("1600-2000", "After-hours session", group = G2)
